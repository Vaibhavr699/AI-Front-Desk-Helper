# Server
PORT=3000
# Backend root only (no /dashboard). Used for Twilio webhooks, transfer, recording callbacks.
BASE_URL=https://your-app.onrender.com
NODE_ENV=production

# Database (PostgreSQL). Supabase: Project Settings → Database → Connection string (URI). Use Transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or local: DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
# Alternative env name (same value): SUPABASE_DATABASE_URL=
DATABASE_URL=

# Stripe webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Rep Coach — separate Stripe context (can be TEST mode while the above is live)
REP_COACH_STRIPE_SECRET_KEY=
REP_COACH_STRIPE_WEBHOOK_SECRET=
REP_COACH_STRIPE_CHECKOUT_URL=
# Rep-seat price IDs (per seat / month) for dashboard-allocated billing
REP_COACH_STRIPE_PRICE_STANDARD=
REP_COACH_STRIPE_PRICE_PRO=
REP_COACH_STRIPE_PRICE_ELITE=

# Twilio (single master account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# OpenAI
OPENAI_API_KEY=
# Optional: voice/quality. Realtime: OPENAI_REALTIME_VOICE (e.g. shimmer, coral). TTS: OPENAI_TTS_MODEL=tts-1-hd, OPENAI_TTS_VOICE=nova. REALTIME_SILENCE_MS=800 (wait longer before replying—helps with listening)

# AWS S3 (recordings)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_RECORDINGS=

# Optional: Twilio Recording Storage (alternative to S3 copy)
# Configure in Twilio Console: Recording Settings -> External S3

# Email (Resend) – password reset, contact form, booking confirmation, transfer notification
RESEND_API_KEY=
EMAIL_FROM=AI Front Desk <onboarding@yourdomain.com>
TRANSFER_NOTIFICATION_EMAIL=
# Optional: if dashboard is on a different origin (e.g. :3089), set this so password-reset links point to the dashboard.
# DASHBOARD_URL=http://116.202.210.102:3089
# Optional: override where contact form and website chat notifications are sent (default: drew@aifrontdeskhelper.com).
# CONTACT_EMAIL=drew@aifrontdeskhelper.com

# Dashboard auth
JWT_SECRET=change-me-to-a-long-random-string

# Optional: Zapier/DripJobs – fallback webhook when tenant has no crm_webhook_url
# Payloads include tenant_id, tenant_name, company_name so you can route in Zapier
# ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Test call script: TEST_CALL_FROM / TEST_CALL_TO = 716 → 402 mode. Set TEST_RING_NUMBER to have the AI number call you (your phone rings, answer to hear the AI).
# TEST_CALL_FROM=+17164133735
# TEST_CALL_TO=+14027738795
# TEST_RING_NUMBER=+15551234567

# LiveKit (for automated caller / bot testing – optional)
# From LiveKit Cloud: Project Settings → Keys. Use URL for your project (e.g. wss://your-project.livekit.cloud).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
