  -- 3. Stories — feeds into siding_sqft calculation
  (NULL, 'stories', 'select',
   'How many stories is your home?',
   'We use this to estimate total wall surface. 3+ stories routes to in-person estimate.',
   '[
     {"value": "single",     "label": "Single story",          "story_coef": 0.85},
     {"value": "split",      "label": "Split level",           "story_coef": 1.20},
     {"value": "two_story",  "label": "Two-story",             "story_coef": 1.50},
     {"value": "three_plus", "label": "Three or more stories", "routes_to": "specialized"}
   ]', TRUE, 3),

  -- 4. Existing removal
  (NULL, 'existing_removal', 'select',
   'Does existing siding need to be removed?',
   'New construction skips removal. Asbestos siding requires in-person inspection.',
   '[
     {"value": "no_removal",    "label": "New construction (no removal)"},
     {"value": "vinyl_removal", "label": "Remove vinyl or aluminum"},
     {"value": "wood_removal",  "label": "Remove wood or cedar"},
     {"value": "asbestos",      "label": "Asbestos siding present", "routes_to": "specialized"}
   ]', TRUE, 4),

  -- 5. Siding complexity (multi-select)
  (NULL, 'siding_complexity', 'multi_select',
   'Does your home have any of these features? (Pick all that apply)',
   NULL,
   '[
     {"value": "dormers",         "label": "Dormers"},
     {"value": "bay_windows",     "label": "Bay windows"},
     {"value": "complex_corners", "label": "Complex corner work"},
     {"value": "custom_cuts",     "label": "Lots of custom cuts or angles"},
     {"value": "mixed_materials", "label": "Mixing siding materials"}
   ]', FALSE, 5),

  -- 6. Trim detail
  (NULL, 'trim_detail', 'select',
   'How much trim, fascia, and soffit work is involved?',
   NULL,
   '[
     {"value": "minimal",   "label": "Minimal trim"},
     {"value": "average",   "label": "Average trim"},
     {"value": "extensive", "label": "Extensive trim, fascia, or soffit work"}
   ]', TRUE, 6),

  -- 7. Access difficulty
  (NULL, 'access_difficulty', 'select',
   'How would you describe property access?',
   'Tight lots, steep terrain, or limited equipment access can add to the cost.',
   '[
     {"value": "standard",     "label": "Standard — flat lot, easy access"},
     {"value": "complex",      "label": "Tight or sloped lot"},
     {"value": "very_complex", "label": "Very difficult access", "routes_to": "specialized"}
   ]', TRUE, 7),

  -- 8. Special notes (optional, sort 90 to match roofing pattern)
  (NULL, 'special_notes', 'text',
   'Anything else we should know? (Optional)',
   'Tell us about anything unusual — historic home, HOA requirements, recent storm damage, etc.',
   '{"max_length": 500}', FALSE, 90)

) AS q(service_slug, question_slug, question_type, label, helper_text, options, required, sort_order)
WHERE v.slug = 'siding'
ON CONFLICT (vertical_id, service_slug, question_slug) DO NOTHING;

-- ============================================================================
