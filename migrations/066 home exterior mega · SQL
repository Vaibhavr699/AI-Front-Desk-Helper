-- ============================================================================
-- Migration 066 — Phase 7 Estimator: Home Exterior Mega-Vertical
-- Date:    May 11, 2026
-- Author:  Drew Koch
-- Phase:   7 (Estimator Engine V1, Wave 2 — Paragon Exteriors launch)
--
-- Context:
--   The first multi-trade customer (Paragon Exteriors) needs a single
--   vertical that bundles roofing + siding + fence + gutters. Rather than
--   refactor to multi-vertical-tenant architecture, we create a unified
--   "home_exterior" mega-vertical containing copies of all 20 services
--   from the 4 standalone trade verticals (Migs 062 through 065).
--
-- Architecture:
--   - Services / default_rates / scope_options: COPIED from trade verticals
--     via slug-based joins, so changes to industry pricing only need to be
--     made in one place per trade if we ever want to keep them synced.
--   - Modifier categories: CUSTOM-designed for the mega. Trade-specific
--     categories that share slugs across trades (existing_removal) are
--     renamed with trade prefixes (existing_siding_removal, etc.) to satisfy
--     the (vertical_id, category_slug) unique constraint.
--   - Widget questions: CUSTOM-designed. Trade-scoped via service_slug
--     column — widget shows questions where service_slug is NULL (universal),
--     equals selected service slug, or equals selected service's trade
--     ('roofing' / 'siding' / 'fence' / 'gutters'). Requires the widget JS
--     to derive trade from the selected service slug.
--
-- Standalone trade verticals (Migs 062-065) remain intact and untouched.
-- They stay useful for any future single-trade customer (e.g., Demo Roofing
-- Co for sales demos, a fencing-only contractor, etc.).
--
-- Idempotency:
--   ON CONFLICT DO NOTHING throughout. Safe to re-run.
-- ============================================================================

BEGIN;

-- ============================================================================
-- SECTION 1: Mega-vertical
-- ============================================================================
INSERT INTO verticals (slug, display_name, status, pricing_mode) VALUES
  ('home_exterior', 'Home Exterior Services', 'active', 'bundled')
ON CONFLICT (slug) DO NOTHING;

DO $$
DECLARE
  v_mega_id INTEGER;
BEGIN
  SELECT vertical_id INTO v_mega_id FROM verticals WHERE slug = 'home_exterior';
  RAISE NOTICE 'home_exterior vertical_id = %', v_mega_id;
END $$;

-- ============================================================================
-- SECTION 2: Regional multipliers
-- ============================================================================
INSERT INTO vertical_regional_multipliers (vertical_id, bucket, multiplier)
SELECT v.vertical_id, b.bucket, b.mult
FROM verticals v
CROSS JOIN (VALUES ('high', 1.25), ('mid', 1.00), ('low', 0.85)) AS b(bucket, mult)
WHERE v.slug = 'home_exterior'
ON CONFLICT (vertical_id, bucket) DO NOTHING;

-- ============================================================================
-- SECTION 3: Services — COPIED from 4 trade verticals (20 rows)
-- ============================================================================
-- sort_order is re-assigned so all 20 services appear in trade-grouped order
-- in the widget service picker: 1-5 roofing, 6-10 siding, 11-15 fence,
-- 16-20 gutters.
-- ----------------------------------------------------------------------------
INSERT INTO vertical_services (vertical_id, service_slug, display_name, pricing_mode, unit, sort_order, materials_pct)
SELECT
  mega.vertical_id,
  vs.service_slug,
  vs.display_name,
  vs.pricing_mode,
  vs.unit,
  CASE tv.slug
    WHEN 'roofing' THEN vs.sort_order          -- 1-5
    WHEN 'siding'  THEN vs.sort_order + 5      -- 6-10
    WHEN 'fence'   THEN vs.sort_order + 10     -- 11-15
    WHEN 'gutters' THEN vs.sort_order + 15     -- 16-20
  END AS sort_order,
  vs.materials_pct
FROM vertical_services vs
JOIN verticals tv ON tv.vertical_id = vs.vertical_id
CROSS JOIN (SELECT vertical_id FROM verticals WHERE slug = 'home_exterior') AS mega
WHERE tv.slug IN ('roofing', 'siding', 'fence', 'gutters')
ON CONFLICT (vertical_id, service_slug) DO NOTHING;

