-- ----- 5.7: Painting default rates (Mid bucket = Gladiators baseline) -----
-- High and Low buckets derived from Mid via vertical_regional_multipliers.
-- Storing all three explicitly lets app layer query directly without computing.
-- Cents-based for precision (no floating point currency math).

-- Insert Mid bucket rates first (the source of truth from Gladiators data)
-- Then High = Mid * 1.50, Low = Mid * 0.85

INSERT INTO vertical_default_rates (vertical_id, service_slug, cost_region, base_rate_min_cents, base_rate_max_cents, unit, notes)
SELECT v.vertical_id, r.service_slug, r.region, r.min_cents, r.max_cents, r.unit, r.notes
FROM verticals v
CROSS JOIN (VALUES
  -- ===== Interior — per-room-size-bucket rates =====
  -- Per Brain Dump Session 2: $8-$9/sqft of floor area, full pack
  -- Small ~100 sqft = $800-$900 (Mid baseline)
  -- Medium ~200 sqft = $1600-$1800
  -- Large ~300 sqft = $2400-$2700
  -- XL ~450 sqft = $3600-$4050

  ('interior', 'mid',  80000,  90000, 'room_small',  'Gladiators-seed: 10x10 room full pack'),
  ('interior', 'mid', 160000, 180000, 'room_medium', 'Gladiators-seed: 12x16 room full pack'),
  ('interior', 'mid', 240000, 270000, 'room_large',  'Gladiators-seed: 14x20 room full pack'),
  ('interior', 'mid', 360000, 405000, 'room_xl',     'Gladiators-seed: 16x24+ room full pack'),

  -- High bucket = Mid * 1.50
  ('interior', 'high', 120000, 135000, 'room_small',  'Derived: Mid * 1.50'),
  ('interior', 'high', 240000, 270000, 'room_medium', 'Derived: Mid * 1.50'),
  ('interior', 'high', 360000, 405000, 'room_large',  'Derived: Mid * 1.50'),
  ('interior', 'high', 540000, 607500, 'room_xl',     'Derived: Mid * 1.50'),

  -- Low bucket = Mid * 0.85
  ('interior', 'low',  68000,  76500, 'room_small',  'Derived: Mid * 0.85'),
  ('interior', 'low', 136000, 153000, 'room_medium', 'Derived: Mid * 0.85'),
  ('interior', 'low', 204000, 229500, 'room_large',  'Derived: Mid * 0.85'),
  ('interior', 'low', 306000, 344250, 'room_xl',     'Derived: Mid * 0.85'),

  -- ===== Exterior — per-paintable-sqft rates =====
  -- Per Brain Dump Session 2: $2.05-$2.95/sqft of paintable surface (paint-on-paint baseline)
  -- 205 cents to 295 cents per sqft for Mid bucket

  ('exterior', 'mid',  205, 295, 'paintable_sqft', 'Gladiators-seed: paint-on-paint baseline'),
  ('exterior', 'high', 308, 443, 'paintable_sqft', 'Derived: Mid * 1.50'),
  ('exterior', 'low',  174, 251, 'paintable_sqft', 'Derived: Mid * 0.85'),

  -- ===== Cabinets — flat $125 per facing =====
  -- Per Brain Dump Session 2: $125 flat per door/drawer facing, paint-on-paint
  -- Variance comes from quantity, not per-facing rate
  -- Stored as min=max for "flat" rate semantics

  ('cabinets', 'mid',  12500, 12500, 'door_drawer_facing', 'Gladiators-seed: $125 flat per facing, paint-on-paint'),
  ('cabinets', 'high', 18750, 18750, 'door_drawer_facing', 'Derived: Mid * 1.50'),
  ('cabinets', 'low',  10625, 10625, 'door_drawer_facing', 'Derived: Mid * 0.85'),

  -- ===== Deck/Fence — industry-default rates (NOT Gladiators-calibrated) =====
  -- Per Brain Dump Session 2 Path 2: industry averages, calibrate post-launch
  -- Deck staining: $2.50-$4.50/sqft Mid baseline
  -- Fence staining: $2.50-$4.00/linear ft Mid baseline (6-foot standard)

  ('deck_fence', 'mid',  250, 450, 'deck_sqft',   'Industry-default: deck staining/sealing. CALIBRATE POST-LAUNCH.'),
  ('deck_fence', 'high', 375, 675, 'deck_sqft',   'Derived: Mid * 1.50'),
  ('deck_fence', 'low',  213, 383, 'deck_sqft',   'Derived: Mid * 0.85'),

  ('deck_fence', 'mid',  250, 400, 'fence_linear_ft', 'Industry-default: 6-foot fence staining. CALIBRATE POST-LAUNCH.'),
  ('deck_fence', 'high', 375, 600, 'fence_linear_ft', 'Derived: Mid * 1.50'),
  ('deck_fence', 'low',  213, 340, 'fence_linear_ft', 'Derived: Mid * 0.85')

) AS r(service_slug, region, min_cents, max_cents, unit, notes)
WHERE v.slug = 'painting'
ON CONFLICT (vertical_id, service_slug, cost_region, unit) DO NOTHING;

