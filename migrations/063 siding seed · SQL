  ('siding_metal',        'low',  102000, 170000, 'square', 'Derived: Mid * 0.85')

) AS r(service_slug, region, min_cents, max_cents, unit, notes)
WHERE v.slug = 'siding'
ON CONFLICT (vertical_id, service_slug, cost_region, unit) DO NOTHING;

