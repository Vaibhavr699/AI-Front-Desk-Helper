-- ============================================================================
-- SECTION 9: VERIFICATION
-- ============================================================================
DO $$
DECLARE
  v_siding_id            INTEGER;
  v_services_count       INTEGER;
  v_modifiers_count      INTEGER;
  v_junction_count       INTEGER;
  v_questions_count      INTEGER;
  v_rates_count          INTEGER;
  v_multipliers_count    INTEGER;
  v_scope_count          INTEGER;
BEGIN
  SELECT vertical_id INTO v_siding_id FROM verticals WHERE slug = 'siding';

  SELECT COUNT(*) INTO v_services_count
    FROM vertical_services WHERE vertical_id = v_siding_id;
  SELECT COUNT(*) INTO v_modifiers_count
    FROM vertical_modifier_categories WHERE vertical_id = v_siding_id;
  SELECT COUNT(*) INTO v_junction_count
    FROM vertical_service_modifier_categories vsmc
    JOIN vertical_services vs ON vs.id = vsmc.service_id
    WHERE vs.vertical_id = v_siding_id;
  SELECT COUNT(*) INTO v_questions_count
    FROM vertical_widget_questions WHERE vertical_id = v_siding_id;
  SELECT COUNT(*) INTO v_rates_count
    FROM vertical_default_rates WHERE vertical_id = v_siding_id;
  SELECT COUNT(*) INTO v_multipliers_count
    FROM vertical_regional_multipliers WHERE vertical_id = v_siding_id;
  SELECT COUNT(*) INTO v_scope_count
    FROM vertical_scope_options vso
    JOIN vertical_services vs ON vs.id = vso.vertical_service_id
    WHERE vs.vertical_id = v_siding_id;

  RAISE NOTICE '====================================================================';
  RAISE NOTICE 'Migration 063 — Siding Vertical Seed COMPLETE';
  RAISE NOTICE '====================================================================';
  RAISE NOTICE 'Siding vertical_id:          %', v_siding_id;
  RAISE NOTICE 'Services:                    %  (expected: 5)', v_services_count;
  RAISE NOTICE 'Modifier categories:         %  (expected: 4)', v_modifiers_count;
  RAISE NOTICE 'Service-modifier mappings:   %  (expected: 20)', v_junction_count;
  RAISE NOTICE 'Widget questions:            %  (expected: 8)', v_questions_count;
  RAISE NOTICE 'Default rates:               %  (expected: 15)', v_rates_count;
  RAISE NOTICE 'Regional multipliers:        %  (expected: 3)', v_multipliers_count;
  RAISE NOTICE 'Scope options:               %  (expected: 30)', v_scope_count;
  RAISE NOTICE '====================================================================';
END $$;

COMMIT;
