# Backend port for Vite dev server proxy (optional if using VITE_API_URL)
BACKEND_PORT=3001

# Full backend URL — no trailing slash (e.g. https://your-backend.onrender.com or ngrok URL).
# Set in frontend env (e.g. Render Static Site env) so the built app calls your backend.
VITE_API_URL=http://localhost:3001
