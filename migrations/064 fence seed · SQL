   'Pool fence requirements, electric/gas line locations, pet considerations, etc.',
   '{"max_length": 500}', FALSE, 90)

) AS q(service_slug, question_slug, question_type, label, helper_text, options, required, sort_order)
WHERE v.slug = 'fence'
ON CONFLICT (vertical_id, service_slug, question_slug) DO NOTHING;

