-- ============================================================================
-- Migration 065 — Phase 7 Estimator: Gutters Vertical Seed
-- Date:    May 11, 2026
-- Author:  Drew Koch
-- Phase:   7 (Estimator Engine V1, Wave 2 — Paragon Exteriors launch)
--
-- Context:
--   Adds Gutters as the fifth vertical for Phase 7. Per Drew's spec for
--   Paragon Exteriors: "everything but cleaning" — install, replacement,
--   repair (via specialized routing for major), downspouts, gutter guards.
--   No standalone cleaning service.
--
-- Pricing model:
--   base_cost = gutter_linear_ft × per_lf_rate
--   downspouts billed per-unit via flat_per_item modifier (matches fence
--   gates_count pattern from Mig 064).
--
-- Service strategy:
--   Four "install gutters" services (5" aluminum, 6" aluminum, half-round,
--   copper) plus a fifth standalone "gutter_guards" service for customers
--   adding guards to existing gutters. Guard upgrades for new gutters are
--   available as a per_lf scope option on each install service.
--
-- Idempotency:
--   ON CONFLICT DO NOTHING throughout. Safe to re-run.
-- ============================================================================

BEGIN;

-- ============================================================================
-- SECTION 1: SEED — Gutters vertical
-- ============================================================================
INSERT INTO verticals (slug, display_name, status, pricing_mode) VALUES
  ('gutters', 'Gutters', 'active', 'bundled')
ON CONFLICT (slug) DO NOTHING;

DO $$
DECLARE
  v_gutters_id INTEGER;
BEGIN
  SELECT vertical_id INTO v_gutters_id FROM verticals WHERE slug = 'gutters';
  RAISE NOTICE 'Gutters vertical_id = %', v_gutters_id;
END $$;

-- ============================================================================
-- SECTION 2: SEED — Gutters regional multipliers
-- ============================================================================
INSERT INTO vertical_regional_multipliers (vertical_id, bucket, multiplier)
SELECT v.vertical_id, b.bucket, b.mult
FROM verticals v
CROSS JOIN (VALUES
  ('high', 1.25),
  ('mid',  1.00),
  ('low',  0.85)
) AS b(bucket, mult)
WHERE v.slug = 'gutters'
ON CONFLICT (vertical_id, bucket) DO NOTHING;

-- ============================================================================
-- SECTION 3: SEED — Gutters services (5 rows)
-- ============================================================================
INSERT INTO vertical_services (vertical_id, service_slug, display_name, pricing_mode, unit, sort_order, materials_pct)
SELECT v.vertical_id, s.slug, s.display_name, s.pricing_mode, s.unit, s.sort_order, s.materials_pct
FROM verticals v
CROSS JOIN (VALUES
  ('gutter_aluminum_5in', '5" Aluminum Gutters',      'bundled_per_unit_area', 'linear_foot', 1, 40.00),
  ('gutter_aluminum_6in', '6" Aluminum Gutters',      'bundled_per_unit_area', 'linear_foot', 2, 45.00),
  ('gutter_half_round',   'Half-Round Gutters',       'bundled_per_unit_area', 'linear_foot', 3, 55.00),
  ('gutter_copper',       'Copper Gutters',           'bundled_per_unit_area', 'linear_foot', 4, 75.00),
  ('gutter_guards',       'Gutter Guards (existing)', 'bundled_per_unit_area', 'linear_foot', 5, 50.00)
) AS s(slug, display_name, pricing_mode, unit, sort_order, materials_pct)
WHERE v.slug = 'gutters'
ON CONFLICT (vertical_id, service_slug) DO NOTHING;

-- ============================================================================
-- SECTION 4: SEED — Gutters modifier categories (4 rows)
-- ============================================================================
-- gutter_height: percentage modifier (ladder labor scales with story count)
-- existing_removal: percentage modifier
-- downspouts_count: flat_per_item (mirrors fence gates_count, Mig 064)
-- access_difficulty: percentage modifier
-- ----------------------------------------------------------------------------
INSERT INTO vertical_modifier_categories (vertical_id, category_slug, display_name, modifier_type, multi_select, options, sort_order)
SELECT v.vertical_id, m.slug, m.display_name, m.mod_type, m.multi_select, m.options::jsonb, m.sort_order
FROM verticals v
CROSS JOIN (VALUES

  -- Gutter height (single-select; affects ladder/labor difficulty)
  ('gutter_height', 'Gutter height (stories)', 'percentage', FALSE,
   '[
     {"value": "single",     "label": "Single story",          "adjustment":  0.00},
     {"value": "two_story",  "label": "Two-story",             "adjustment":  0.15},
     {"value": "three_plus", "label": "Three or more stories", "adjustment": null, "routes_to": "specialized"}
   ]', 1),

  -- Existing removal (single-select)
  ('existing_removal', 'Existing gutter removal', 'percentage', FALSE,
   '[
     {"value": "no_removal",       "label": "New construction (no removal)",   "adjustment": 0.00},
     {"value": "aluminum_removal", "label": "Remove existing aluminum",        "adjustment": 0.05},
     {"value": "severe_damage",    "label": "Severe damage / rusted / falling","adjustment": 0.15}
   ]', 2),

  -- Downspouts count (flat_per_item; mirrors fence gates pattern)
  -- adjustment is per-downspout cost in CENTS (15000 = $150/downspout).
  ('downspouts_count', 'Number of downspouts', 'flat_per_item', FALSE,
   '[
     {"value": "downspouts", "label": "Downspouts", "adjustment": 15000}
   ]', 3),

  -- Access difficulty (single-select)
  ('access_difficulty', 'Access difficulty', 'percentage', FALSE,
   '[
     {"value": "standard",     "label": "Standard access",       "adjustment":  0.00},
     {"value": "complex",      "label": "Tight or sloped lot",   "adjustment":  0.10},
     {"value": "very_complex", "label": "Very difficult access", "adjustment": null, "routes_to": "specialized"}
   ]', 4)

) AS m(slug, display_name, mod_type, multi_select, options, sort_order)
WHERE v.slug = 'gutters'
ON CONFLICT (vertical_id, category_slug) DO NOTHING;

-- ============================================================================
-- SECTION 5: SEED — Service-modifier junction (20 rows = 4 mods × 5 services)
-- ============================================================================
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT s.id, m.id, mapping.required, mapping.sort_order
FROM vertical_services s
JOIN verticals v ON s.vertical_id = v.vertical_id
JOIN vertical_modifier_categories m ON m.vertical_id = v.vertical_id
JOIN (VALUES
  ('gutter_aluminum_5in', 'gutter_height',     TRUE,  1),
  ('gutter_aluminum_5in', 'existing_removal',  TRUE,  2),
  ('gutter_aluminum_5in', 'downspouts_count',  FALSE, 3),
  ('gutter_aluminum_5in', 'access_difficulty', TRUE,  4),

  ('gutter_aluminum_6in', 'gutter_height',     TRUE,  1),
  ('gutter_aluminum_6in', 'existing_removal',  TRUE,  2),
  ('gutter_aluminum_6in', 'downspouts_count',  FALSE, 3),
  ('gutter_aluminum_6in', 'access_difficulty', TRUE,  4),

  ('gutter_half_round',   'gutter_height',     TRUE,  1),
  ('gutter_half_round',   'existing_removal',  TRUE,  2),
  ('gutter_half_round',   'downspouts_count',  FALSE, 3),
  ('gutter_half_round',   'access_difficulty', TRUE,  4),

  ('gutter_copper',       'gutter_height',     TRUE,  1),
  ('gutter_copper',       'existing_removal',  TRUE,  2),
  ('gutter_copper',       'downspouts_count',  FALSE, 3),
  ('gutter_copper',       'access_difficulty', TRUE,  4),

  ('gutter_guards',       'gutter_height',     TRUE,  1),
  ('gutter_guards',       'existing_removal',  FALSE, 2),
  ('gutter_guards',       'downspouts_count',  FALSE, 3),
  ('gutter_guards',       'access_difficulty', TRUE,  4)
) AS mapping(service_slug, mod_slug, required, sort_order)
  ON s.service_slug = mapping.service_slug AND m.category_slug = mapping.mod_slug
WHERE v.slug = 'gutters'
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

-- ============================================================================
