{
  "expo": {
    "name": "AI Rep Coach",
    "slug": "ai-rep-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AI_Rep_coach.png",
    "scheme": "aifdh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airepcoach.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "AI Rep Coach uses Face ID to unlock the app on this device.",
        "NSMicrophoneUsageDescription": "AI Rep Coach records in-home sales conversations so they can be transcribed and coached."
      }
    },
    "android": {
      "package": "com.airepcoach.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/AI_Rep_coach.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/AI_Rep_coach.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AI Rep Coach uses Face ID to unlock the app on this device."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      "expo-sqlite",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49a9c8e4-c6ea-4f05-94f0-f16396a88480"
      }
    },
    "owner": "rahull"
  }
}
