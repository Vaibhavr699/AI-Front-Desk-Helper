-- Universal: access_difficulty applies to all 20 services
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT vs.id, vmc.id, TRUE, 99
FROM vertical_services vs
JOIN verticals v ON v.vertical_id = vs.vertical_id
JOIN vertical_modifier_categories vmc ON vmc.vertical_id = v.vertical_id
WHERE v.slug = 'home_exterior'
  AND vmc.category_slug = 'access_difficulty'
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

-- Roofing-specific: roof_complexity, decking_condition for 5 roofing services
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT vs.id, vmc.id,
       CASE vmc.category_slug WHEN 'decking_condition' THEN TRUE ELSE FALSE END AS required,
       CASE vmc.category_slug WHEN 'roof_complexity' THEN 1 WHEN 'decking_condition' THEN 2 END AS sort_order
FROM vertical_services vs
JOIN verticals v ON v.vertical_id = vs.vertical_id
JOIN vertical_modifier_categories vmc ON vmc.vertical_id = v.vertical_id
WHERE v.slug = 'home_exterior'
  AND vs.service_slug IN ('asphalt_shingle', 'metal_standing_seam', 'tile', 'slate', 'flat_epdm')
  AND vmc.category_slug IN ('roof_complexity', 'decking_condition')
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

-- Siding-specific: siding_complexity, trim_detail, existing_siding_removal for 5 siding services
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT vs.id, vmc.id,
       CASE vmc.category_slug
         WHEN 'siding_complexity'       THEN FALSE
         WHEN 'trim_detail'             THEN TRUE
         WHEN 'existing_siding_removal' THEN TRUE
       END AS required,
       CASE vmc.category_slug
         WHEN 'siding_complexity'       THEN 1
         WHEN 'trim_detail'             THEN 2
         WHEN 'existing_siding_removal' THEN 3
       END AS sort_order
FROM vertical_services vs
JOIN verticals v ON v.vertical_id = vs.vertical_id
JOIN vertical_modifier_categories vmc ON vmc.vertical_id = v.vertical_id
WHERE v.slug = 'home_exterior'
  AND vs.service_slug IN ('siding_vinyl', 'siding_fiber_cement', 'siding_wood', 'siding_stucco', 'siding_metal')
  AND vmc.category_slug IN ('siding_complexity', 'trim_detail', 'existing_siding_removal')
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

-- Fence-specific: fence_height, terrain, existing_fence_removal, gates_count for 5 fence services
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT vs.id, vmc.id,
       CASE vmc.category_slug
         WHEN 'fence_height'           THEN TRUE
         WHEN 'terrain'                THEN TRUE
         WHEN 'existing_fence_removal' THEN TRUE
         WHEN 'gates_count'            THEN FALSE
       END AS required,
       CASE vmc.category_slug
         WHEN 'fence_height'           THEN 1
         WHEN 'terrain'                THEN 2
         WHEN 'existing_fence_removal' THEN 3
         WHEN 'gates_count'            THEN 4
       END AS sort_order
FROM vertical_services vs
JOIN verticals v ON v.vertical_id = vs.vertical_id
JOIN vertical_modifier_categories vmc ON vmc.vertical_id = v.vertical_id
WHERE v.slug = 'home_exterior'
  AND vs.service_slug IN ('fence_wood_privacy', 'fence_vinyl', 'fence_chain_link', 'fence_aluminum_ornamental', 'fence_composite')
  AND vmc.category_slug IN ('fence_height', 'terrain', 'existing_fence_removal', 'gates_count')
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

-- Gutter-specific: gutter_height, existing_gutter_removal, downspouts_count for 5 gutter services
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT vs.id, vmc.id,
       CASE vmc.category_slug
         WHEN 'gutter_height'            THEN TRUE
         WHEN 'existing_gutter_removal'  THEN FALSE
         WHEN 'downspouts_count'         THEN FALSE
       END AS required,
       CASE vmc.category_slug
         WHEN 'gutter_height'            THEN 1
         WHEN 'existing_gutter_removal'  THEN 2
         WHEN 'downspouts_count'         THEN 3
       END AS sort_order
FROM vertical_services vs
JOIN verticals v ON v.vertical_id = vs.vertical_id
JOIN vertical_modifier_categories vmc ON vmc.vertical_id = v.vertical_id
WHERE v.slug = 'home_exterior'
  AND vs.service_slug IN ('gutter_aluminum_5in', 'gutter_aluminum_6in', 'gutter_half_round', 'gutter_copper', 'gutter_guards')
  AND vmc.category_slug IN ('gutter_height', 'existing_gutter_removal', 'downspouts_count')
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

