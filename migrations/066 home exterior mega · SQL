-- ============================================================================
-- SECTION 7: Default rates — COPIED from 4 trade verticals (60 rows)
-- ============================================================================
INSERT INTO vertical_default_rates (vertical_id, service_slug, cost_region, base_rate_min_cents, base_rate_max_cents, unit, notes)
SELECT
  mega.vertical_id,
  dr.service_slug,
  dr.cost_region,
  dr.base_rate_min_cents,
  dr.base_rate_max_cents,
  dr.unit,
  dr.notes
FROM vertical_default_rates dr
JOIN verticals tv ON tv.vertical_id = dr.vertical_id
CROSS JOIN (SELECT vertical_id FROM verticals WHERE slug = 'home_exterior') AS mega
WHERE tv.slug IN ('roofing', 'siding', 'fence', 'gutters')
ON CONFLICT (vertical_id, service_slug, cost_region, unit) DO NOTHING;

-- ============================================================================
-- SECTION 8: Scope options — COPIED from 4 trade verticals (120 rows)
-- ============================================================================
-- Maps OLD vertical_service_id → NEW vertical_service_id via service_slug.
-- ----------------------------------------------------------------------------
INSERT INTO vertical_scope_options (vertical_service_id, option_key, display_label, default_enabled, affects_includes_text, modifier_type, price_modifier_default, display_order)
SELECT
  new_vs.id,
  vso.option_key,
  vso.display_label,
  vso.default_enabled,
  vso.affects_includes_text,
  vso.modifier_type,
  vso.price_modifier_default,
  vso.display_order
FROM vertical_scope_options vso
JOIN vertical_services old_vs ON old_vs.id = vso.vertical_service_id
JOIN verticals old_v ON old_v.vertical_id = old_vs.vertical_id
JOIN verticals mega_v ON mega_v.slug = 'home_exterior'
JOIN vertical_services new_vs
  ON new_vs.vertical_id = mega_v.vertical_id
 AND new_vs.service_slug = old_vs.service_slug
WHERE old_v.slug IN ('roofing', 'siding', 'fence', 'gutters')
ON CONFLICT (vertical_service_id, option_key) DO NOTHING;

-- ============================================================================
-- SECTION 9: Verification
-- ============================================================================
DO $$
DECLARE
  v_mega_id              INTEGER;
  v_services_count       INTEGER;
  v_modifiers_count      INTEGER;
  v_junction_count       INTEGER;
  v_questions_count      INTEGER;
  v_rates_count          INTEGER;
  v_multipliers_count    INTEGER;
  v_scope_count          INTEGER;
BEGIN
  SELECT vertical_id INTO v_mega_id FROM verticals WHERE slug = 'home_exterior';

  SELECT COUNT(*) INTO v_services_count    FROM vertical_services WHERE vertical_id = v_mega_id;
  SELECT COUNT(*) INTO v_modifiers_count   FROM vertical_modifier_categories WHERE vertical_id = v_mega_id;
  SELECT COUNT(*) INTO v_junction_count    FROM vertical_service_modifier_categories vsmc
    JOIN vertical_services vs ON vs.id = vsmc.service_id WHERE vs.vertical_id = v_mega_id;
  SELECT COUNT(*) INTO v_questions_count   FROM vertical_widget_questions WHERE vertical_id = v_mega_id;
  SELECT COUNT(*) INTO v_rates_count       FROM vertical_default_rates WHERE vertical_id = v_mega_id;
  SELECT COUNT(*) INTO v_multipliers_count FROM vertical_regional_multipliers WHERE vertical_id = v_mega_id;
  SELECT COUNT(*) INTO v_scope_count       FROM vertical_scope_options vso
    JOIN vertical_services vs ON vs.id = vso.vertical_service_id WHERE vs.vertical_id = v_mega_id;

  RAISE NOTICE '====================================================================';
  RAISE NOTICE 'Migration 066 — Home Exterior Mega-Vertical COMPLETE';
  RAISE NOTICE '====================================================================';
  RAISE NOTICE 'home_exterior vertical_id:   %', v_mega_id;
  RAISE NOTICE 'Services:                    %  (expected: 20)', v_services_count;
  RAISE NOTICE 'Modifier categories:         %  (expected: 13)', v_modifiers_count;
  RAISE NOTICE 'Service-modifier mappings:   %  (expected: 80)', v_junction_count;
  RAISE NOTICE 'Widget questions:            %  (expected: 24)', v_questions_count;
  RAISE NOTICE 'Default rates:               %  (expected: 60)', v_rates_count;
  RAISE NOTICE 'Regional multipliers:        %  (expected: 3)', v_multipliers_count;
  RAISE NOTICE 'Scope options:               %  (expected: 120)', v_scope_count;
  RAISE NOTICE '====================================================================';
END $$;

COMMIT;
