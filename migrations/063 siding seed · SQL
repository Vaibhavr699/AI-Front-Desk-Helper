-- ============================================================================
-- Migration 063 — Phase 7 Estimator: Siding Vertical Seed
-- Date:    May 11, 2026
-- Author:  Drew Koch
-- Phase:   7 (Estimator Engine V1, Wave 2 — Paragon Exteriors launch)
--
-- Context:
--   Adds Siding as the third vertical for Phase 7, alongside painting (Mig
--   047) and roofing (Mig 062). Built off the Mighty Dog Siding Components
--   playbook. No schema changes — only seed data.
--
-- Pricing model:
--   siding_sqft = home_floor_sqft × story_coefficient
--   squares     = siding_sqft / 100
--   base_cost   = squares × per_square_rate
--   Mirrors painting exterior storyCoef pattern: single=0.85, split=1.20,
--   two_story=1.50, three_plus → specialized.
--
-- Pricing:
--   Industry midpoints from Mighty Dog playbook. Paragon-calibrate after
--   first 10 jobs. All rates flagged "CALIBRATE POST-LAUNCH" the same way
--   roofing rates in Mig 062 were.
--
-- Idempotency:
--   ON CONFLICT DO NOTHING throughout. Safe to re-run.
-- ============================================================================

BEGIN;

-- ============================================================================
-- SECTION 1: SEED — Siding vertical
-- ============================================================================
INSERT INTO verticals (slug, display_name, status, pricing_mode) VALUES
  ('siding', 'Siding', 'active', 'bundled')
ON CONFLICT (slug) DO NOTHING;

DO $$
DECLARE
  v_siding_id INTEGER;
BEGIN
  SELECT vertical_id INTO v_siding_id FROM verticals WHERE slug = 'siding';
  RAISE NOTICE 'Siding vertical_id = %', v_siding_id;
END $$;

-- ============================================================================
-- SECTION 2: SEED — Siding regional multipliers
-- ============================================================================
INSERT INTO vertical_regional_multipliers (vertical_id, bucket, multiplier)
SELECT v.vertical_id, b.bucket, b.mult
FROM verticals v
CROSS JOIN (VALUES
  ('high', 1.25),
  ('mid',  1.00),
  ('low',  0.85)
) AS b(bucket, mult)
WHERE v.slug = 'siding'
ON CONFLICT (vertical_id, bucket) DO NOTHING;

-- ============================================================================
-- SECTION 3: SEED — Siding services (5 rows)
-- ============================================================================
INSERT INTO vertical_services (vertical_id, service_slug, display_name, pricing_mode, unit, sort_order, materials_pct)
SELECT v.vertical_id, s.slug, s.display_name, s.pricing_mode, s.unit, s.sort_order, s.materials_pct
FROM verticals v
CROSS JOIN (VALUES
  ('siding_vinyl',        'Vinyl Siding',                'bundled_per_unit_area', 'square', 1, 40.00),
  ('siding_fiber_cement', 'Fiber Cement (Hardie Board)', 'bundled_per_unit_area', 'square', 2, 55.00),
  ('siding_wood',         'Wood / Cedar Siding',         'bundled_per_unit_area', 'square', 3, 60.00),
  ('siding_stucco',       'Stucco / EIFS',               'bundled_per_unit_area', 'square', 4, 35.00),
  ('siding_metal',        'Metal Panel Siding',          'bundled_per_unit_area', 'square', 5, 60.00)
) AS s(slug, display_name, pricing_mode, unit, sort_order, materials_pct)
WHERE v.slug = 'siding'
ON CONFLICT (vertical_id, service_slug) DO NOTHING;

-- ============================================================================
-- SECTION 4: SEED — Siding modifier categories (4 rows)
-- ============================================================================
-- Note: home_floor_sqft and stories are NOT modifiers — they're inputs
-- consumed by computeSidingBase() in lib/estimator.js (similar to roofing).
-- Only the % modifiers below live in vertical_modifier_categories.
-- ----------------------------------------------------------------------------
INSERT INTO vertical_modifier_categories (vertical_id, category_slug, display_name, modifier_type, multi_select, options, sort_order)
SELECT v.vertical_id, m.slug, m.display_name, m.mod_type, m.multi_select, m.options::jsonb, m.sort_order
FROM verticals v
CROSS JOIN (VALUES

  -- Siding complexity (multi-select; each picked item compounds)
  ('siding_complexity', 'Siding features', 'percentage', TRUE,
   '[
     {"value": "dormers",         "label": "Dormers",                     "adjustment": 0.08},
     {"value": "bay_windows",     "label": "Bay windows",                 "adjustment": 0.10},
     {"value": "complex_corners", "label": "Complex corner work",         "adjustment": 0.06},
     {"value": "custom_cuts",     "label": "Lots of custom cuts/angles",  "adjustment": 0.12},
     {"value": "mixed_materials", "label": "Mixed siding materials",      "adjustment": 0.15}
   ]', 1),

  -- Trim detail (single-select)
  ('trim_detail', 'Trim detail', 'percentage', FALSE,
   '[
     {"value": "minimal",   "label": "Minimal trim",                  "adjustment": -0.05},
     {"value": "average",   "label": "Average trim",                  "adjustment": 0.00},
     {"value": "extensive", "label": "Extensive trim/fascia/soffit",  "adjustment": 0.10}
   ]', 2),

  -- Existing removal (single-select; asbestos routes to specialized)
  ('existing_removal', 'Existing siding', 'percentage', FALSE,
   '[
     {"value": "no_removal",    "label": "New construction (no removal)", "adjustment": 0.00},
     {"value": "vinyl_removal", "label": "Remove vinyl or aluminum",      "adjustment": 0.08},
     {"value": "wood_removal",  "label": "Remove wood or cedar",          "adjustment": 0.12},
     {"value": "asbestos",      "label": "Asbestos siding present",       "adjustment": null, "routes_to": "specialized"}
   ]', 3),

  -- Access difficulty (single-select; very_complex routes to specialized)
  ('access_difficulty', 'Access difficulty', 'percentage', FALSE,
   '[
     {"value": "standard",     "label": "Standard access",       "adjustment": 0.00},
     {"value": "complex",      "label": "Tight or sloped lot",   "adjustment": 0.10},
     {"value": "very_complex", "label": "Very difficult access", "adjustment": null, "routes_to": "specialized"}
   ]', 4)

) AS m(slug, display_name, mod_type, multi_select, options, sort_order)
WHERE v.slug = 'siding'
ON CONFLICT (vertical_id, category_slug) DO NOTHING;

-- ============================================================================
-- SECTION 5: SEED — Service-modifier junction (20 rows = 4 mods × 5 services)
-- ============================================================================
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT s.id, m.id, mapping.required, mapping.sort_order
FROM vertical_services s
JOIN verticals v ON s.vertical_id = v.vertical_id
JOIN vertical_modifier_categories m ON m.vertical_id = v.vertical_id
JOIN (VALUES
  ('siding_vinyl',        'siding_complexity', FALSE, 1),
  ('siding_vinyl',        'trim_detail',       TRUE,  2),
  ('siding_vinyl',        'existing_removal',  TRUE,  3),
  ('siding_vinyl',        'access_difficulty', TRUE,  4),

  ('siding_fiber_cement', 'siding_complexity', FALSE, 1),
  ('siding_fiber_cement', 'trim_detail',       TRUE,  2),
  ('siding_fiber_cement', 'existing_removal',  TRUE,  3),
  ('siding_fiber_cement', 'access_difficulty', TRUE,  4),

  ('siding_wood',         'siding_complexity', FALSE, 1),
  ('siding_wood',         'trim_detail',       TRUE,  2),
  ('siding_wood',         'existing_removal',  TRUE,  3),
  ('siding_wood',         'access_difficulty', TRUE,  4),

  ('siding_stucco',       'siding_complexity', FALSE, 1),
  ('siding_stucco',       'trim_detail',       TRUE,  2),
  ('siding_stucco',       'existing_removal',  TRUE,  3),
  ('siding_stucco',       'access_difficulty', TRUE,  4),

  ('siding_metal',        'siding_complexity', FALSE, 1),
  ('siding_metal',        'trim_detail',       TRUE,  2),
  ('siding_metal',        'existing_removal',  TRUE,  3),
  ('siding_metal',        'access_difficulty', TRUE,  4)
) AS mapping(service_slug, mod_slug, required, sort_order)
  ON s.service_slug = mapping.service_slug AND m.category_slug = mapping.mod_slug
WHERE v.slug = 'siding'
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

-- ============================================================================
-- SECTION 6: SEED — Widget questions (8 universal)
-- ============================================================================
-- All questions have service_slug=NULL because all 5 siding services use
-- the same flow. The service_type select at the top picks the siding
-- material; everything else applies universally.
-- ----------------------------------------------------------------------------
INSERT INTO vertical_widget_questions (vertical_id, service_slug, question_slug, question_type, label, helper_text, options, required, sort_order)
SELECT v.vertical_id, q.service_slug, q.question_slug, q.question_type, q.label, q.helper_text, q.options::jsonb, q.required, q.sort_order
FROM verticals v
CROSS JOIN (VALUES

  -- 1. Service type (siding material) — universal first question
  (NULL, 'service_type', 'select',
   'What siding material are you installing?',
   'Not sure? Pick the closest match — we''ll confirm during the walkthrough.',
   '[
     {"value": "siding_vinyl",        "label": "Vinyl siding"},
     {"value": "siding_fiber_cement", "label": "Fiber cement (Hardie board)"},
     {"value": "siding_wood",         "label": "Wood / cedar"},
     {"value": "siding_stucco",       "label": "Stucco / EIFS"},
     {"value": "siding_metal",        "label": "Metal panel siding"},
     {"value": "specialized",         "label": "Not sure / specialized project"}
   ]', TRUE, 1),

  -- 2. Home floor sqft
  (NULL, 'home_floor_sqft', 'number',
   'Approximately how many square feet is your home?',
   'Use the total finished floor area (typically on your real estate listing). We use this to estimate siding surface.',
