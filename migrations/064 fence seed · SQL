-- ============================================================================
-- Migration 064 — Phase 7 Estimator: Fence Vertical Seed
-- Date:    May 11, 2026
-- Author:  Drew Koch
-- Phase:   7 (Estimator Engine V1, Wave 2 — Paragon Exteriors launch)
--
-- Context:
--   Adds Fence as the fourth vertical for Phase 7. Built off industry
--   standards. Per-linear-foot pricing (simpler than siding/roofing —
--   no geometric area calculation needed).
--
-- Pricing model:
--   base_cost = fence_linear_ft × per_lf_rate
--   Then apply project modifiers (height, terrain, gates, removal)
--   Then apply scope options
--
-- Key differences from siding (Mig 063):
--   - unit = 'linear_foot' instead of 'square'
--   - No story coefficient (fences don't scale with home stories)
--   - gates_count is a flat_per_item modifier (mirrors painting's
--     glass_inserts pattern from Mig 047)
--   - fence_height replaces the trim_detail dimension
--
-- Pricing:
--   Industry midpoints — chain link cheapest, composite premium.
--   Paragon-calibrate after first 10 fence jobs.
--
-- Idempotency:
--   ON CONFLICT DO NOTHING throughout. Safe to re-run.
-- ============================================================================

BEGIN;

-- ============================================================================
-- SECTION 1: SEED — Fence vertical
-- ============================================================================
INSERT INTO verticals (slug, display_name, status, pricing_mode) VALUES
  ('fence', 'Fence', 'active', 'bundled')
ON CONFLICT (slug) DO NOTHING;

DO $$
DECLARE
  v_fence_id INTEGER;
BEGIN
  SELECT vertical_id INTO v_fence_id FROM verticals WHERE slug = 'fence';
  RAISE NOTICE 'Fence vertical_id = %', v_fence_id;
END $$;

-- ============================================================================
-- SECTION 2: SEED — Fence regional multipliers
-- ============================================================================
INSERT INTO vertical_regional_multipliers (vertical_id, bucket, multiplier)
SELECT v.vertical_id, b.bucket, b.mult
FROM verticals v
CROSS JOIN (VALUES
  ('high', 1.25),
  ('mid',  1.00),
  ('low',  0.85)
) AS b(bucket, mult)
WHERE v.slug = 'fence'
ON CONFLICT (vertical_id, bucket) DO NOTHING;

-- ============================================================================
-- SECTION 3: SEED — Fence services (5 rows)
-- ============================================================================
INSERT INTO vertical_services (vertical_id, service_slug, display_name, pricing_mode, unit, sort_order, materials_pct)
SELECT v.vertical_id, s.slug, s.display_name, s.pricing_mode, s.unit, s.sort_order, s.materials_pct
FROM verticals v
CROSS JOIN (VALUES
  ('fence_wood_privacy',        'Wood Privacy Fence',         'bundled_per_unit_area', 'linear_foot', 1, 45.00),
  ('fence_vinyl',               'Vinyl Fence',                'bundled_per_unit_area', 'linear_foot', 2, 55.00),
  ('fence_chain_link',          'Chain Link Fence',           'bundled_per_unit_area', 'linear_foot', 3, 50.00),
  ('fence_aluminum_ornamental', 'Aluminum / Ornamental Fence','bundled_per_unit_area', 'linear_foot', 4, 60.00),
  ('fence_composite',           'Composite Fence',            'bundled_per_unit_area', 'linear_foot', 5, 65.00)
) AS s(slug, display_name, pricing_mode, unit, sort_order, materials_pct)
WHERE v.slug = 'fence'
ON CONFLICT (vertical_id, service_slug) DO NOTHING;

-- ============================================================================
-- SECTION 4: SEED — Fence modifier categories (4 rows)
-- ============================================================================
-- Note: fence_linear_ft is NOT a modifier — it's the primary input consumed
-- by computeFenceBase() in lib/estimator.js. Only the modifiers below live
-- in vertical_modifier_categories.
--
-- gates_count is flat_per_item — mirrors painting's glass_inserts pattern
-- from Mig 047. adjustment is in CENTS (40000 = $400 per gate).
-- ----------------------------------------------------------------------------
INSERT INTO vertical_modifier_categories (vertical_id, category_slug, display_name, modifier_type, multi_select, options, sort_order)
SELECT v.vertical_id, m.slug, m.display_name, m.mod_type, m.multi_select, m.options::jsonb, m.sort_order
FROM verticals v
CROSS JOIN (VALUES

  -- Fence height (single-select; affects total material + labor)
  ('fence_height', 'Fence height', 'percentage', FALSE,
   '[
     {"value": "4ft", "label": "4 feet (decorative)",       "adjustment": -0.15},
     {"value": "6ft", "label": "6 feet (standard privacy)", "adjustment":  0.00},
     {"value": "8ft", "label": "8 feet (maximum privacy)",  "adjustment":  0.25}
   ]', 1),

  -- Terrain (single-select; very_steep routes to specialized)
  ('terrain', 'Property terrain', 'percentage', FALSE,
   '[
     {"value": "flat",       "label": "Flat or gentle slope",    "adjustment":  0.00},
     {"value": "sloped",     "label": "Sloped (stepped panels)", "adjustment":  0.10},
     {"value": "very_steep", "label": "Very steep terrain",      "adjustment": null, "routes_to": "specialized"}
   ]', 2),

  -- Existing removal (single-select)
  ('existing_removal', 'Existing fence removal', 'percentage', FALSE,
   '[
     {"value": "no_removal",        "label": "No existing fence (new install)",         "adjustment": 0.00},
     {"value": "chain_link_removal","label": "Remove existing chain link / wire",       "adjustment": 0.05},
     {"value": "wood_removal",      "label": "Remove existing wood fence",              "adjustment": 0.10},
     {"value": "concrete_footings", "label": "Existing concrete footings need removal", "adjustment": 0.20}
   ]', 3),

  -- Gates count (flat_per_item; per painting glass_inserts pattern)
  -- adjustment is per-gate cost in CENTS. Widget passes `gates_count` as the
  -- count via the same pattern as glass_inserts_count.
  ('gates_count', 'Number of gates', 'flat_per_item', FALSE,
   '[
     {"value": "gates", "label": "Gates", "adjustment": 40000}
   ]', 4)

) AS m(slug, display_name, mod_type, multi_select, options, sort_order)
WHERE v.slug = 'fence'
ON CONFLICT (vertical_id, category_slug) DO NOTHING;

-- ============================================================================
-- SECTION 5: SEED — Service-modifier junction (20 rows = 4 mods × 5 services)
-- ============================================================================
INSERT INTO vertical_service_modifier_categories (service_id, modifier_category_id, required, sort_order)
SELECT s.id, m.id, mapping.required, mapping.sort_order
FROM vertical_services s
JOIN verticals v ON s.vertical_id = v.vertical_id
JOIN vertical_modifier_categories m ON m.vertical_id = v.vertical_id
JOIN (VALUES
  ('fence_wood_privacy',        'fence_height',     TRUE,  1),
  ('fence_wood_privacy',        'terrain',          TRUE,  2),
  ('fence_wood_privacy',        'existing_removal', TRUE,  3),
  ('fence_wood_privacy',        'gates_count',      FALSE, 4),

  ('fence_vinyl',               'fence_height',     TRUE,  1),
  ('fence_vinyl',               'terrain',          TRUE,  2),
  ('fence_vinyl',               'existing_removal', TRUE,  3),
  ('fence_vinyl',               'gates_count',      FALSE, 4),

  ('fence_chain_link',          'fence_height',     TRUE,  1),
  ('fence_chain_link',          'terrain',          TRUE,  2),
  ('fence_chain_link',          'existing_removal', TRUE,  3),
  ('fence_chain_link',          'gates_count',      FALSE, 4),

  ('fence_aluminum_ornamental', 'fence_height',     TRUE,  1),
  ('fence_aluminum_ornamental', 'terrain',          TRUE,  2),
  ('fence_aluminum_ornamental', 'existing_removal', TRUE,  3),
  ('fence_aluminum_ornamental', 'gates_count',      FALSE, 4),

  ('fence_composite',           'fence_height',     TRUE,  1),
  ('fence_composite',           'terrain',          TRUE,  2),
  ('fence_composite',           'existing_removal', TRUE,  3),
  ('fence_composite',           'gates_count',      FALSE, 4)
) AS mapping(service_slug, mod_slug, required, sort_order)
  ON s.service_slug = mapping.service_slug AND m.category_slug = mapping.mod_slug
WHERE v.slug = 'fence'
ON CONFLICT (service_id, modifier_category_id) DO NOTHING;

-- ============================================================================
-- SECTION 6: SEED — Widget questions (8 universal)
-- ============================================================================
