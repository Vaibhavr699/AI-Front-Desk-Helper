 Date:    April 30, 2026
-- Author:  Drew Koch
-- Phase:   7 (Estimator Engine V1)
--
-- Context:
--   Establishes the multi-vertical architecture for Phase 7 Estimator.
--   Per Drew's Path B decision (Apr 30): build vertical-aware tables from
--   Day 1 rather than refactoring after painting V1 ships. Painting is
--   seeded as the first (and only) vertical for V1. Roofing, fencing, and
--   future verticals add via configuration only — no code changes.
--
--   Captures decisions from Brain Dump Sessions 1 & 2 (Apr 29-30, 2026).
--   See conversation transcript for full decision rationale.
--
-- Tables created:
--   1. verticals                            — vertical registry
--   2. vertical_services                    — service types per vertical
--   3. vertical_modifier_categories         — modifier dictionary per vertical
--   4. vertical_service_modifier_categories — junction (which mods apply to which services)
--   5. vertical_widget_questions            — homeowner-facing form questions
--   6. vertical_default_rates               — per-service/region default rates
--   7. state_cost_buckets                   — global state→bucket mapping
--   8. vertical_regional_multipliers        — per-vertical bucket multipliers
--
-- Tenant column additions:
--   - vertical_id                  — which vertical the tenant operates in
--   - cost_region                  — bucket override (high/mid/low/custom/null=auto)
--   - cost_custom_percentage       — used when cost_region='custom'
--   - estimator_widget_enabled     — toggle 1: widget on website
--   - estimator_pop_enabled        — toggle 2: proactive bubble pop
--   - estimator_voice_enabled      — toggle 3: voice quoting (V1 placeholder, V2 wires real)
--   - estimator_addon_purchased    — Basic/Pro paywall gate ($15/mo add-on)
--
-- Lead column addition:
--   - estimator_payload JSONB      — full project scope from estimator widget
--
-- Idempotency:
--   Safe to run multiple times. Uses CREATE TABLE IF NOT EXISTS, defensive
--   DO blocks for column additions, and ON CONFLICT clauses for seed data.
-- ============================================================================

BEGIN;

-- ============================================================================
-- SECTION 1: SCHEMA — Tables, indexes, foreign keys
-- ============================================================================

-- ----------------------------------------------------------------------------
-- Table 1: verticals
-- The registry of home services verticals supported by the estimator engine.
-- Painting is seeded in V1. Roofing, fencing, HVAC, etc. add as new rows in V2+.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS verticals (
  vertical_id    SERIAL PRIMARY KEY,
  slug           VARCHAR(50) UNIQUE NOT NULL,
  display_name   VARCHAR(100) NOT NULL,
  status         VARCHAR(20) NOT NULL DEFAULT 'active',
    -- 'active' | 'draft' | 'archived'
  pricing_mode   VARCHAR(30) NOT NULL DEFAULT 'bundled',
    -- 'bundled' | 'split' (labor + materials separate)
    -- Painting V1 = bundled. Roofing/Fencing V2 = split.
  created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_verticals_slug ON verticals(slug);
CREATE INDEX IF NOT EXISTS idx_verticals_status ON verticals(status);

COMMENT ON TABLE verticals IS
  'Registry of home services verticals (painting, roofing, fencing, etc.). One row per vertical.';
COMMENT ON COLUMN verticals.pricing_mode IS
  'bundled = single rate covers labor+materials. split = labor and materials priced separately. Painting V1 = bundled.';

-- ----------------------------------------------------------------------------
-- Table 2: vertical_services
-- The services offered within each vertical. Per-service pricing_mode allows
-- different math per service even within one vertical (Interior is per-room,
-- Exterior is per-paintable-sqft, Cabinets is per-facing).
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS vertical_services (
  id                  SERIAL PRIMARY KEY,
  vertical_id         INTEGER NOT NULL REFERENCES verticals(vertical_id) ON DELETE CASCADE,
  service_slug        VARCHAR(50) NOT NULL,
  display_name        VARCHAR(100) NOT NULL,
  pricing_mode        VARCHAR(40) NOT NULL,
    -- 'bundled_per_unit_area' | 'bundled_per_item_count' | 'split_per_unit_area' | 'flat_range'
  unit                VARCHAR(30) NOT NULL,
    -- 'sqft' | 'linear_ft' | 'door_drawer_facing' | 'room' | 'item' | 'job'
  sort_order          INTEGER NOT NULL DEFAULT 0,
  enabled_by_default  BOOLEAN NOT NULL DEFAULT TRUE,
  is_specialized      BOOLEAN NOT NULL DEFAULT FALSE,
    -- TRUE = routes to in-person, no widget quote
  materials_pct       DECIMAL(5,2),
    -- Painting metadata only (V1). NULL for split-mode verticals.
  created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (vertical_id, service_slug)
);

CREATE INDEX IF NOT EXISTS idx_vertical_services_vertical_id ON vertical_services(vertical_id);

COMMENT ON TABLE vertical_services IS
  'Services offered within each vertical. Painting has Interior/Exterior/Cabinets/Deck-Fence + specialized.';
COMMENT ON COLUMN vertical_services.pricing_mode IS
  'Math model for this service. bundled_per_unit_area=rate*area*modifiers. bundled_per_item_count=rate*count*modifiers.';
COMMENT ON COLUMN vertical_services.materials_pct IS
  'Painting V1 metadata: approximate % of rate that is materials. Does not affect math, used for analytics.';

-- ----------------------------------------------------------------------------
-- Table 3: vertical_modifier_categories
-- The modifier dictionary per vertical. Each category has options stored as
-- JSONB. Engine reads (category_slug, selected_option) and looks up adjustment.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS vertical_modifier_categories (
  id                  SERIAL PRIMARY KEY,
  vertical_id         INTEGER NOT NULL REFERENCES verticals(vertical_id) ON DELETE CASCADE,
  category_slug       VARCHAR(50) NOT NULL,
  display_name        VARCHAR(100) NOT NULL,
  modifier_type       VARCHAR(20) NOT NULL DEFAULT 'percentage',
    -- 'percentage' | 'flat_per_item' | 'flat_per_project'
  multi_select        BOOLEAN NOT NULL DEFAULT FALSE,
    -- TRUE = homeowner can pick multiple options, all adjustments compound
  options             JSONB NOT NULL DEFAULT '[]'::jsonb,
    -- [{value, label, adjustment}] — adjustment is decimal (0.25 = +25%)
    -- For flat_per_item: adjustment is dollar amount in cents (3500 = $35)
  sort_order          INTEGER NOT NULL DEFAULT 0,
  created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (vertical_id, category_slug)
);

CREATE INDEX IF NOT EXISTS idx_vertical_modifier_categories_vertical_id
  ON vertical_modifier_categories(vertical_id);

COMMENT ON TABLE vertical_modifier_categories IS
  'Modifier dictionary per vertical. Pricing engine reads category+selection, applies adjustment.';
COMMENT ON COLUMN vertical_modifier_categories.modifier_type IS
  'percentage = multiplicative (1+adj). flat_per_item = additive in cents. flat_per_project = single addition.';

-- ----------------------------------------------------------------------------
-- Table 4: vertical_service_modifier_categories (junction)
-- Maps which modifier categories apply to which services. Cabinets gets
-- finish_change/glass_inserts/damage. Interior gets year_built/style/complexity.
-- Without this, widget would show year-built question to Cabinets shoppers.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS vertical_service_modifier_categories (
  id                          SERIAL PRIMARY KEY,
  service_id                  INTEGER NOT NULL REFERENCES vertical_services(id) ON DELETE CASCADE,
  modifier_category_id        INTEGER NOT NULL REFERENCES vertical_modifier_categories(id) ON DELETE CASCADE,
  required                    BOOLEAN NOT NULL DEFAULT FALSE,
  sort_order                  INTEGER NOT NULL DEFAULT 0,
  UNIQUE (service_id, modifier_category_id)
);

CREATE INDEX IF NOT EXISTS idx_vsmc_service_id
  ON vertical_service_modifier_categories(service_id);
CREATE INDEX IF NOT EXISTS idx_vsmc_modifier_category_id
  ON vertical_service_modifier_categories(modifier_category_id);

COMMENT ON TABLE vertical_service_modifier_categories IS
  'Junction: which modifier categories apply to which services. Painting has different mod sets per service.';

-- ----------------------------------------------------------------------------
-- Table 5: vertical_widget_questions
-- The homeowner-facing form questions. Widget loads these per tenant's vertical
-- via /api/widget/estimator-config. Order, required-ness, options all driven
-- from this table — no hardcoded form structure in widget JS.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS vertical_widget_questions (
  id                SERIAL PRIMARY KEY,
  vertical_id       INTEGER NOT NULL REFERENCES verticals(vertical_id) ON DELETE CASCADE,
  service_slug      VARCHAR(50),
    -- NULL = applies to all services in vertical
    -- non-NULL = only shown when this service is selected
  question_slug     VARCHAR(50) NOT NULL,
  question_type     VARCHAR(30) NOT NULL,
    -- 'select' | 'multi_select' | 'number' | 'year_input' | 'text' | 'yes_no' | 'size_bucket'
  label             TEXT NOT NULL,
  helper_text       TEXT,
  options           JSONB DEFAULT '[]'::jsonb,
    -- For select/multi_select: [{value, label}]
    -- For number: {min, max, step, unit}
    -- For size_bucket: [{value, label, midpoint_value}]
  required          BOOLEAN NOT NULL DEFAULT TRUE,
  sort_order        INTEGER NOT NULL DEFAULT 0,
  created_at        TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (vertical_id, service_slug, question_slug)
);

CREATE INDEX IF NOT EXISTS idx_vertical_widget_questions_vertical_id
  ON vertical_widget_questions(vertical_id);
CREATE INDEX IF NOT EXISTS idx_vertical_widget_questions_service_slug
  ON vertical_widget_questions(service_slug);

COMMENT ON TABLE vertical_widget_questions IS
  'Homeowner-facing form questions. Widget renders dynamically from this table per tenant vertical.';
COMMENT ON COLUMN vertical_widget_questions.service_slug IS
  'NULL = applies to all services. Set = only rendered when this service is selected.';

-- ----------------------------------------------------------------------------
-- Table 6: vertical_default_rates
-- Per-service, per-region base rate ranges. Mid bucket is baseline (seeded
-- from Gladiators data). High = Mid * vertical's high multiplier. Low = Mid * low.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS vertical_default_rates (
  id                       SERIAL PRIMARY KEY,
  vertical_id              INTEGER NOT NULL REFERENCES verticals(vertical_id) ON DELETE CASCADE,
  service_slug             VARCHAR(50) NOT NULL,
  cost_region              VARCHAR(10) NOT NULL,
    -- 'high' | 'mid' | 'low'
  base_rate_min_cents      INTEGER NOT NULL,
  base_rate_max_cents      INTEGER NOT NULL,
  unit                     VARCHAR(30) NOT NULL,
    -- 'sqft' | 'linear_ft' | 'door_drawer_facing' | 'room_small' | 'room_medium' | 'room_large' | 'room_xl'
  notes                    TEXT,
  created_at               TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (vertical_id, service_slug, cost_region, unit)
);

CREATE INDEX IF NOT EXISTS idx_vertical_default_rates_lookup
  ON vertical_default_rates(vertical_id, service_slug, cost_region);

COMMENT ON TABLE vertical_default_rates IS
  'Per-service, per-region default rate ranges. Mid = baseline (Gladiators-seeded). Painters customize in Settings.';

-- ----------------------------------------------------------------------------
-- Table 7: state_cost_buckets
-- Global state→bucket mapping. All verticals use the same state-to-bucket
-- assignment (cost-of-living differences are a fact, not vertical-specific).
-- Per-vertical multipliers in vertical_regional_multipliers.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS state_cost_buckets (
  state_code   CHAR(2) PRIMARY KEY,
  bucket       VARCHAR(10) NOT NULL,
    -- 'high' | 'mid' | 'low'
  notes        TEXT,
  updated_at   TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE state_cost_buckets IS
  'Global state-to-bucket mapping. Roughly tracks regional cost-of-living for trades work.';

-- ----------------------------------------------------------------------------
-- Table 8: vertical_regional_multipliers
-- Per-vertical multipliers applied to Mid-bucket base rates to produce
-- High and Low bucket rates. Painting V1: high=1.50, mid=1.00, low=0.85.
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS vertical_regional_multipliers (
  id           SERIAL PRIMARY KEY,
  vertical_id  INTEGER NOT NULL REFERENCES verticals(vertical_id) ON DELETE CASCADE,
  bucket       VARCHAR(10) NOT NULL,
    -- 'high' | 'mid' | 'low'
  multiplier   DECIMAL(4,2) NOT NULL,
    -- e.g. 1.50, 1.00, 0.85
  UNIQUE (vertical_id, bucket)
);

CREATE INDEX IF NOT EXISTS idx_vertical_regional_multipliers_vertical_id
  ON vertical_regional_multipliers(vertical_id);

COMMENT ON TABLE vertical_regional_multipliers IS
  'Per-vertical multipliers per bucket. Roofing in High = different mult than Painting in High.';

-- ============================================================================
-- SECTION 2: TENANT COLUMN ADDITIONS
-- ============================================================================
-- Adding estimator-related columns to tenants table. Defensive DO block
-- handles re-runs gracefully.
-- ----------------------------------------------------------------------------

DO $$
BEGIN
  -- vertical_id: which vertical this tenant operates in
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='tenants' AND column_name='vertical_id') THEN
    ALTER TABLE tenants ADD COLUMN vertical_id INTEGER REFERENCES verticals(vertical_id);
    RAISE NOTICE 'Added tenants.vertical_id';
  END IF;

  -- cost_region: bucket override (NULL = auto-detect from state)
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='tenants' AND column_name='cost_region') THEN
    ALTER TABLE tenants ADD COLUMN cost_region VARCHAR(10) DEFAULT NULL;
      -- 'high' | 'mid' | 'low' | 'custom' | NULL (auto-detect from state)
    RAISE NOTICE 'Added tenants.cost_region';
  END IF;

  -- cost_custom_percentage: used when cost_region='custom'
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='tenants' AND column_name='cost_custom_percentage') THEN
    ALTER TABLE tenants ADD COLUMN cost_custom_percentage DECIMAL(5,2) DEFAULT NULL;
      -- e.g. 18.00 means +18%, validated -50 to +100 in app layer
    RAISE NOTICE 'Added tenants.cost_custom_percentage';
  END IF;

  -- Three estimator toggles (per Brain Dump Session 1, Q5)
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='tenants' AND column_name='estimator_widget_enabled') THEN
    ALTER TABLE tenants ADD COLUMN estimator_widget_enabled BOOLEAN NOT NULL DEFAULT FALSE;
    RAISE NOTICE 'Added tenants.estimator_widget_enabled';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='tenants' AND column_name='estimator_pop_enabled') THEN
    ALTER TABLE tenants ADD COLUMN estimator_pop_enabled BOOLEAN NOT NULL DEFAULT FALSE;
    RAISE NOTICE 'Added tenants.estimator_pop_enabled';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='tenants' AND column_name='estimator_voice_enabled') THEN
    ALTER TABLE tenants ADD COLUMN estimator_voice_enabled BOOLEAN NOT NULL DEFAULT FALSE;
      -- V1 placeholder. V2 wires real voice integration.
    RAISE NOTICE 'Added tenants.estimator_voice_enabled (V1 placeholder)';
  END IF;

  -- estimator_addon_purchased: Basic/Pro paywall gate
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='tenants' AND column_name='estimator_addon_purchased') THEN
    ALTER TABLE tenants ADD COLUMN estimator_addon_purchased BOOLEAN NOT NULL DEFAULT FALSE;
      -- Elite/Franchise/HQ tiers: ignored (always have access)
      -- Basic/Pro: must be TRUE for toggles to function
      -- Reseller-acquired: hidden entirely (handled in app layer)
    RAISE NOTICE 'Added tenants.estimator_addon_purchased';
  END IF;
END $$;

-- ============================================================================
-- SECTION 3: LEAD COLUMN ADDITION
-- ============================================================================
-- Per Brain Dump Session 1, Q7a: full estimator project payload as JSONB on
-- existing leads table. No separate estimator_submissions table.
-- ----------------------------------------------------------------------------

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
                 WHERE table_name='leads' AND column_name='estimator_payload') THEN
    ALTER TABLE leads ADD COLUMN estimator_payload JSONB DEFAULT NULL;
      -- Full submission: service, area, modifiers selected, calculated range, etc.
      -- Painter sees this rendered as "Project details from estimator" on lead detail page.
    RAISE NOTICE 'Added leads.estimator_payload';
  END IF;
END $$;

